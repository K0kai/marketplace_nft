# Liga o MSW (REST + Socket.IO simulados). Necessário no build de demonstração.
VITE_ENABLE_MOCKS=true
# Base da API REST. Com mocks pode ficar vazio (mesma origem).
VITE_API_URL=
# URL do servidor Socket.IO. Vazio = mesma origem.
VITE_SOCKET_URL=
# Timeout das requisições (ms)
VITE_API_TIMEOUT_MS=8000
